# Example nginx server block for reverse-proxying the go-trade-bot MCP
# server (cmd/mcp --transport=http, port 8090 - see docker-compose.yml's
# `mcp` service) through to a Cloudflare Tunnel.
#
# Assumes the "subdomain per tool" pattern: this is ONE server block among
# several in your existing nginx config, matched by server_name, alongside
# whatever other tools you already route this way on the same notebook.
# Copy this into wherever those other server blocks live (e.g.
# /etc/nginx/conf.d/mcp.conf or a docker-compose-mounted nginx.conf include)
# and swap mcp.yourdomain.com for your real hostname.
#
# TLS is NOT terminated here - Cloudflare Tunnel (cloudflared) already
# terminates TLS at Cloudflare's edge and reaches this nginx over the
# tunnel's own encrypted connection, so this listens on plain HTTP. Do not
# expose this port directly to the internet outside the tunnel.

server {
    listen 80;
    server_name mcp.yourdomain.com;

    location / {
        # "mcp" resolves via Docker's embedded DNS to the container_name in
        # docker-compose.yml - only works if nginx is on the same compose
        # network (either add nginx to that project's docker-compose.yml, or
        # put both stacks on one shared external Docker network).
        proxy_pass http://mcp:8090;

        proxy_http_version 1.1;

        # The MCP streamable-HTTP transport (github.com/modelcontextprotocol/
        # go-sdk) can hold a connection open and stream chunked responses for
        # a tool call - buffering here would either break that or add
        # needless latency. Long timeouts because a real tool call
        # (run_backtest against a wide date range) can legitimately take
        # well over nginx's 60s defaults.
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Authorization must reach cmd/mcp unmodified - that Bearer token is
        # the ONLY auth this endpoint enforces on its own (see
        # internal/middleware.RequireAuth), so an nginx config that strips or
        # rewrites this header would either break every legitimate client or
        # (worse) silently start allowing unauthenticated requests through if
        # something downstream defaults open. Explicit here so it's obvious
        # this proxy is not the place doing auth - cmd/mcp still is.
        proxy_set_header Authorization $http_authorization;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
